OPENROUTER_API_KEY=sk-or-...
# OpenRouter model slugs. The answer/agent model is open-weight Llama; the judge and
# question generator are a different model family so the system is never graded by itself.
ANSWER_MODEL=meta-llama/llama-3.3-70b-instruct
JUDGE_MODEL=anthropic/claude-sonnet-5.5
GEN_MODEL=anthropic/claude-haiku-5.5
QDRANT_URL=http://localhost:6333
EMBED_MODEL=BAAI/bge-small-en-v1.5
